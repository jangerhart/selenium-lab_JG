SCRAPER_DB_HOST=localhost
SCRAPER_DB_PORT=5432
SCRAPER_DB_NAME=your_database
SCRAPER_DB_USER=price_scraper_ro
SCRAPER_DB_PASSWORD=your_password

# Competitor config (defaults keep Profibagr behavior)
COMPETITOR_CODE=PROFIBAGR
COMPETITOR_NAME=Profibagr
BASE_URL=https://www.profibagr.cz
SEARCH_PATH=/search
SEARCH_PARAM=phrase
COMPETITOR_ENV_FILE=
SCRAPER_MODE=HTML
SEARCH_EXTRA_PARAMS={}

# Optional pacing between product requests in seconds
REQUEST_DELAY_SECONDS=3
