POHODA_DB_HOST=localhost
POHODA_DB_PORT=1433
POHODA_DB_NAME=your_database
POHODA_DB_USER=your_readonly_user
POHODA_DB_PASSWORD=your_password
POHODA_DB_ENCRYPT=true
POHODA_DB_TRUST_SERVER_CERTIFICATE=false

# PostgreSQL provisioning account used for bootstrap/fallback
PG_PROVISION_HOST=localhost
PG_PROVISION_PORT=5432
PG_PROVISION_DB=postgres
PG_PROVISION_USER=your_provision_user
PG_PROVISION_PASSWORD=your_password
PG_PROVISION_SSLMODE=prefer

# PostgreSQL target DB for monitor writes
PG_MONITOR_HOST=localhost
PG_MONITOR_PORT=5432
PG_MONITOR_DB=sandix_price_monitor
PG_MONITOR_USER=your_monitor_user
PG_MONITOR_PASSWORD=your_password
PG_MONITOR_SSLMODE=prefer

# Optional analytics DB bootstrap target
PG_ANALYTICS_HOST=localhost
PG_ANALYTICS_PORT=5432
PG_ANALYTICS_DB=sandix_price_analytics
PG_ANALYTICS_USER=your_analytics_user
PG_ANALYTICS_PASSWORD=your_password
PG_ANALYTICS_SSLMODE=prefer
